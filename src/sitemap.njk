---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- if site.url %}
{%- for p in collections.all %}{% if p.url and p.url != "/404.html" and (p.url.endsWith(".html") or p.url == "/") %}
  <url><loc>{{ p.url | abs(site.url) }}</loc>{% if p.data.updated %}<lastmod>{{ p.data.updated }}</lastmod>{% endif %}</url>
{%- endif %}{% endfor %}
{%- endif %}
</urlset>
