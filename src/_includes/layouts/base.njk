<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " | " + site.name) if title and title != site.name else (site.name + " | " + "Machine learning, simulation, and forecasting") %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#15233F">
  {%- if site.url %}
  <link rel="canonical" href="{{ page.url | abs(site.url) }}">
  <meta property="og:url" content="{{ page.url | abs(site.url) }}">
  <meta property="og:image" content="{{ '/assets/img/social-card.png' | abs(site.url) }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <link rel="icon" href="{{ '/favicon.svg' | rel }}" type="image/svg+xml">
  <link rel="preload" href="{{ '/assets/fonts/instrument-sans-latin-wght-normal.woff2' | rel }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | rel }}">
  {%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | json | safe }}</script>
  {%- endif %}
</head>
<body class="page-{{ bodyClass or 'default' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s | rel }}" defer></script>
  {%- endfor %}{% endif %}
</body>
</html>
